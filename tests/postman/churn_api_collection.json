        {
            "name": "Single Prediction",
            "item": [
                {
                    "name": "Predict - Standard Customer",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"customerID\": \"TEST-001\",\n    \"gender\": \"Male\",\n    \"SeniorCitizen\": \"No\",\n    \"Partner\": \"Yes\",\n    \"Dependents\": \"No\",\n    \"tenure\": 12,\n    \"PhoneService\": \"Yes\",\n    \"MultipleLines\": \"No\",\n    \"InternetService\": \"Fiber optic\",\n    \"OnlineSecurity\": \"No\",\n    \"OnlineBackup\": \"No\",\n    \"DeviceProtection\": \"No\",\n    \"TechSupport\": \"No\",\n    \"StreamingTV\": \"Yes\",\n    \"StreamingMovies\": \"Yes\",\n    \"Contract\": \"Month-to-month\",\n    \"PaperlessBilling\": \"Yes\",\n    \"PaymentMethod\": \"Electronic check\",\n    \"MonthlyCharges\": 85.50,\n    \"TotalCharges\": 1026.0\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/predict",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "predict"
                            ]
                        }
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Status code is 200', function () {",
                                    "    pm.response.to.have.status(200);",
                                    "});",
                                    "",
                                    "pm.test('Response has churn_probability', function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData).to.have.property('churn_probability');",
                                    "});",
                                    "",
                                    "pm.test('Probability is between 0 and 1', function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.churn_probability).to.be.within(0, 1);",
                                    "});",
                                    "",
                                    "pm.test('Response has risk_level', function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData).to.have.property('risk_level');",
                                    "});",
                                    "",
                                    "pm.test('Response has summary', function () {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData).to.have.property('summary');",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
